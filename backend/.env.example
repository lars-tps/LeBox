AUTH_MODE=dev
DEV_JWT_SECRET=dev-secret-change-me
DATABASE_URL=postgresql+asyncpg://lebox:lebox@postgres:5432/lebox

S3_BUCKET=lebox
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
# The browser follows presigned URLs from its own context — it can't resolve
# the docker-compose service name "minio". Override the host used in signed
# URLs to one the browser can reach.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true

CORS_ORIGINS=http://localhost:5173,http://localhost:8080
